{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DETR Eval",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}/detr/",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": [
                "--batch_size", "2",
                "--no_aux_loss",
                "--eval",
                "--resume", "https://dl.fbaipublicfiles.com/detr/detr-r50-e632da11.pth",
                "--coco_path", "playground/data/coco2017"
            ],
            "justMyCode": true
        },
        {
            "name": "DETR Train",
            "type": "python",
            "request": "launch",
            "module": "torch.distributed.launch",

            "cwd": "${workspaceFolder}/detr/",
            "console": "integratedTerminal",

            "args": [
                "--nproc_per_node=1",
                "--use_env",
                "main.py",
                "--coco_path",
                "playground/data/coco2017/"
            ],

            "justMyCode": false,

            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            }
        }
    ]
}
